{
  "name": "filebump",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/filebump",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/packages/filebump"
      },
      "configurations": {
        "development": {
          "outputPath": "packages/filebump"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "filebump:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "filebump:build:development",
          "dev": true,
          "port": 7001
        },
        "production": {
          "buildTarget": "filebump:build:production",
          "dev": false,
          "port": 7001
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "filebump:build:production"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/filebump/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
