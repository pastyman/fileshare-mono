{
  "name": "sharefolder-admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/sharefolder-admin",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/packages/sharefolder-admin"
      },
      "configurations": {
        "development": {
          "outputPath": "packages/sharefolder-admin"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "sharefolder-admin:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "sharefolder-admin:build:development",
          "dev": true,
          "port": 3020
        },
        "production": {
          "buildTarget": "sharefolder-admin:build:production",
          "dev": false,
          "port": 3020
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
